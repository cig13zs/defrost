{
  "manifest_version": 3,
  "name": "Defrost: restore browser controls",
  "version": "1.0.0",
  "description": "Restore text selection, copying, right-click, and unfrozen scroll in one click. Runs offline, zero tracking.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Defrost this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
